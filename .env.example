# ─────────────────────────────────────────────────────────────
# ลอยกระทงออนไลน์ – Environment Variables
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local)
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
# URL สาธารณะของเว็บไซต์ (ไม่มี / ท้าย) ใช้กับ SEO, Canonical, Stripe redirect
NEXT_PUBLIC_APP_URL=http://localhost:3000
# บน Netlify ไม่ต้องตั้ง (ใช้ URL ของเว็บอัตโนมัติ) ยกเว้นใช้โดเมนของตัวเอง

# วันลอยกระทง (ISO 8601) ใช้ใน JSON-LD Event
NEXT_PUBLIC_FESTIVAL_START=2026-11-24T18:00:00+07:00
NEXT_PUBLIC_FESTIVAL_END=2026-11-25T02:00:00+07:00

# ── Supabase ─────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service Role Key: ใช้ฝั่ง Server เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 (รูปบนโคม ≤ 50 MB อัปโหลดตรงจากเบราว์เซอร์) ──
# R2 → Manage R2 API Tokens → Create token (Object Read & Write เฉพาะ bucket นี้)
# เว้นว่างทั้งหมด = ใช้ Supabase Storage แทน (จำกัด ~5 MB ต่อไฟล์บน Netlify)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lantern-assets

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# เปิด PromptPay หลังตรวจสอบว่า Stripe Account (TH) เปิดใช้งาน PromptPay แล้วเท่านั้น
STRIPE_ENABLE_PROMPTPAY=false
# true = รับชำระด้วย QR พร้อมเพย์อย่างเดียว (ต้องเป็น Stripe account ประเทศไทย และเปิด PromptPay ใน Dashboard)
NEXT_PUBLIC_PAYMENT_QR_ONLY=false

# ── Security ─────────────────────────────────────────────────
# สุ่มค่ายาว ๆ เช่น `openssl rand -hex 32`
# ใช้ป้องกัน /api/cron/* (Vercel Cron ส่ง Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# ใช้เซ็น Token สำหรับย้ายโคมจาก Guest ไปยังบัญชีที่มีอยู่แล้ว
CLAIM_TOKEN_SECRET=

# ── Background Music ─────────────────────────────────────────
# ไฟล์เพลงธีม (เสียงอย่างเดียว เปิดอัตโนมัติ วนซ้ำ) – เว้นว่าง = /audio/loykrathong-bgm.mp3
NEXT_PUBLIC_BGM_URL=
